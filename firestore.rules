rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && profile().role == 'admin';
    }

    function isWorker() {
      return signedIn() && profile().role == 'worker';
    }

    function isOwnerBootstrap(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.auth.token.email == 'owner@lagranfamilia.app'
        && request.resource.data.username == 'owner'
        && request.resource.data.role == 'admin';
    }

    function isSelfSignup(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy == null
        && request.resource.data.eulaAcceptedAt is string
        && request.resource.data.eulaVersion is string
        && (
          request.resource.data.role == 'worker'
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.adminAccessCode == 'Ander'
          )
        );
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin() || isWorker();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || isOwnerBootstrap(userId) || isSelfSignup(userId);
      allow update, delete: if isAdmin();
    }

    match /revenue/{docId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{docId} {
      allow read, write: if isAdmin();
    }

    match /merchandise/{docId} {
      allow read, write: if isAdmin();
    }

    match /vendors/{docId} {
      allow read, write: if isAdmin();
    }

    match /employees/{docId} {
      allow read, write: if isAdmin();
    }

    match /deductions/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
